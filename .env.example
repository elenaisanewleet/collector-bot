# ---------------------------------------------------------------- application
APP_ENV=development
# demo — deterministic in-process providers, no credentials needed
# live — real HTTP adapters (each stays NOT_CONFIGURED until configured below)
APP_MODE=demo
# The product name shown to operators. The repository is called collector-bot;
# the product name is not fixed and is changed here only.
APP_NAME=Collector Bot

LOG_LEVEL=INFO
LOG_JSON=false

# ---------------------------------------------------------------- telegram
# Issued by @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Empty means nobody has access.
# «*» — открыть бота всем, кто его найдёт. Каждый чужой запрос тратит
# оплаченный баланс и поднимает данные живых людей под вашей учётной записью.
ALLOWED_TELEGRAM_USER_IDS=
# Владельцы бота: числовые Telegram ID через запятую. Заданы — включается режим
# «доступ по одобрению»: посторонний, написавший боту, получает экран «запрос
# отправлен», а владельцу приходит карточка с именем, ником и кнопками
# «Разрешить» / «Отклонить». Решения хранятся в базе и переживают перезапуск.
# Владелец допущен к боту всегда, даже если его нет в списке выше.
# Пусто — прежнее поведение: посторонний получает «Доступ запрещён».
# «*» в списке выше сильнее: там пущены все и одобрять нечего.
OWNER_TELEGRAM_USER_IDS=

# ---------------------------------------------------------------- storage
DATABASE_URL=sqlite+aiosqlite:///./collector_bot.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/collector_bot

INTERNAL_CSV_PATH=./data/demo_debtors.csv

# ---------------------------------------------------------------- ФССП (NewDB)
# Enforcement proceedings are served by the NewDB aggregator; the direct ФССП
# service (api-ip.fssp.gov.ru) is retired and answers HTTP 410 Gone.
# Request a token at access@newdb.net. Without it the provider reports
# NOT_CONFIGURED and the report says the source was not checked.
NEWDB_API_KEY=
NEWDB_BASE_URL=https://api.newdb.net
NEWDB_METHOD_PATH=/v2
# The call is asynchronous: NEWDB returns queued/in_progress and the adapter
# re-POSTs the same requestId until the task completes.
NEWDB_POLL_ATTEMPTS=10
NEWDB_POLL_INTERVAL_SECONDS=2.0

# ---------------------------------------------------------------- NewDB: остальные методы
# Тот же ключ отвечает за банкротство (bankrot_person), ЕГРИП и роли в ЮЛ
# (egrul_ip), залоги (pledge_person, pledge_vin) и арбитраж (arbitr_person).
#
# Конверт NewDB — в коде: он вычитан из спецификации. Схемы строк живут здесь,
# а не в коде, потому что это контракт вашего деплоя. Метода нет в файле — метод
# не запрашивается, источник остаётся NOT_CONFIGURED, отчёт пишет «не
# проверено». Файл не читается — бот не стартует.
#
# Каждый включённый метод — платный вызов на должника. На прогоне в восемьсот
# строк это восемьсот вызовов на метод.
#
# Готовая карта: config/field_maps/example_newdb.json. Пути в ней сняты с ЖИВЫХ
# ответов сервиса от 05.09.2026 — захваченные тела лежат в
# tests/data/newdb_live_*.json, и тесты гоняют карту по ним дословно. Что
# осталось от архивной документации и не подтверждено живым вызовом, перечислено
# в шапке самой карты: это прежде всего СТРОКА уведомления ФНП (живьём массив
# fnp приходил пустым) и ветка fedresurs[].
NEWDB_FIELD_MAP=

# ---------------------------------------------------------------- ЕФРСБ
# none | demo | generic_json | newdb
# newdb — метод bankrot_person на ключе, который уже оплачивает ФССП;
#         остальные FEDRESURS_* тогда не нужны, нужен NEWDB_FIELD_MAP.
#         Ищет только по ИНН (innfiz): должник без ИНН остаётся непроверенным,
#         и отчёт это пишет прямо, а не выдаёт за чистый реестр.
FEDRESURS_BACKEND=none
FEDRESURS_BASE_URL=
FEDRESURS_SEARCH_PATH=
FEDRESURS_USERNAME=
FEDRESURS_PASSWORD=
FEDRESURS_API_KEY=
# bearer | header | query | basic | none
FEDRESURS_AUTH_STYLE=bearer
FEDRESURS_AUTH_NAME=X-Api-Key
# Path to a JSON field map describing your vendor's response shape.
# See config/field_maps/example_fedresurs.json.
FEDRESURS_FIELD_MAP=

# ---------------------------------------------------------------- ФНС
# none | demo | generic_json | newdb
# newdb — метод egrul_ip, описан в поставляемой карте с 05.09.2026.
#         Вопреки имени, отдаёт НЕ ТОЛЬКО ИП: живой ответ возвращает и роли в
#         юрлицах — руководителя (section «upr») и учредителя («uchr») — наравне
#         с регистрацией ИП. Прежняя оговорка «отвечает только про ИП» была
#         неверна и здесь, и в README.
#         Чего он в этих строках НЕ отдаёт — того, к какому юрлицу относится
#         роль: там ИНН и ФИО человека, а название и ИНН компании лежат в другой
#         ветке ответа, которую одна запись карты не достаёт. Поэтому строка
#         «руководитель ЮЛ: <ФИО>» называет человека, а не компанию.
#         Ищет только по ИНН (innfiz) — отката на ФИО у источника нет.
FNS_PROVIDER=none
FNS_BASE_URL=
FNS_SEARCH_PATH=
FNS_API_KEY=
FNS_AUTH_STYLE=query
FNS_AUTH_NAME=key
FNS_FIELD_MAP=

# ---------------------------------------------------------------- http
REQUEST_TIMEOUT_SECONDS=15
PROVIDER_CONCURRENCY=5
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.5

# ---------------------------------------------------------------- cache
# 0 disables caching entirely.
CACHE_TTL_HOURS=24

# ---------------------------------------------------------------- privacy
# Keep both false unless there is a documented reason not to.
#
# STORE_RAW_RESPONSES=true нужен ровно для одного — сверить карту полей на
# первом должнике. В базу при этом ложится ответ вендора целиком: ФИО, ИНН,
# номера дел, адреса из карточек. Не ложится то, что вырезается всегда и
# независимо от флагов, — СНИЛС, место рождения и адрес проживания
# (app/utils/masking.py, SENSITIVE_RAW_KEYS): живой ответ о банкротстве привозит
# их, ни один путь карты на них не указывает, и хранить чужой СНИЛС ради сверки
# карты незачем.
STORE_RAW_RESPONSES=false
STORE_SENSITIVE_IDENTIFIERS=false

# Получение ИНН физлица по паспорту через ФНС (метод NewDB passport_fns).
# Один дополнительный платный вызов на должника. Без него банкротство, статус ИП
# и арбитраж не проверяются вовсе: эти три источника ищут только по ИНН.
# Включение означает, что серия и номер паспорта уходят во внешний источник.
INN_BRIDGE_ENABLED=false

# ---------------------------------------------------------------- import
MAX_IMPORT_FILE_BYTES=5242880
MAX_IMPORT_ROWS=50000

# ---------------------------------------------------------------- вердикт
# Требования до 500 000 ₽ рассматриваются в приказном порядке (ст. 121 ГПК РФ).
COURT_ORDER_MAX_AMOUNT=500000
# Во сколько раз долг должен превышать пошлину, чтобы процесс окупался.
MIN_DEBT_TO_FEE_RATIO=2.0

# ---------------------------------------------------------------- массовая проверка
# Каждый должник — это реальные запросы к платным источникам, поэтому прогон
# ограничен сверху и требует подтверждения оператора.
BATCH_MAX_DEBTORS=5000
BATCH_CONCURRENCY=4
BATCH_PROGRESS_EVERY=10

# ---------------------------------------------------------------- веб-отчёты
# Отчёт открывается ссылкой на страницу, а не простынёй в чате.
WEB_ENABLED=true
# Слушаем петлю: наружу порт выставляет TLS-терминатор (nginx/Caddy), а не
# приложение. За страницей персональные данные, а токен доступа едет в пути URL.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Публичный адрес, по которому страница доступна снаружи. ПУСТОЙ — ССЫЛКИ НЕ
# ОТПРАВЛЯЮТСЯ, и бот молча уходит на текстовый отчёт в чат. Обязателен https:
# по http токен виден любому узлу на маршруте.
WEB_PUBLIC_URL=
# Разрешить http в WEB_PUBLIC_URL. Только для локальной отладки.
WEB_ALLOW_INSECURE=false
# Сколько живёт ссылка на отчёт по одному должнику.
SHARE_LINK_TTL_HOURS=72
# Ссылка на очередь живёт меньше: за ней вся выгрузка целиком, а не один человек.
SHARE_QUEUE_TTL_HOURS=12
# Сколько дней хранить историю проверок. 0 — не чистить.
HISTORY_RETENTION_DAYS=90
